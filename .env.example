# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Set this in Vercel Environment Variables or local .env.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ROLE_PASSCODES: Optional server-side RBAC passcodes for elevated roles (CDT, PMU, TVGS).
# Leave unset or commented out to run in Demo Mode (free switching without passcode prompt).
# Supported formats:
#   ROLE_PASSCODES="CDT:cdt-pass-2026,PMU:pmu-pass-2026,TVGS:tvgs-pass-2026"
#   ROLE_PASSCODES='{"CDT":"cdt-pass-2026","PMU":"pmu-pass-2026","TVGS":"tvgs-pass-2026"}'
# ROLE_PASSCODES="CDT:cdt-pass-2026,PMU:pmu-pass-2026,TVGS:tvgs-pass-2026"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional local Hybrid SSOT Backend & OCR Sidecar URLs (defaults shown)
VITE_FASTAPI_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_LOCAL_SCANNER_URL="http://127.0.0.1:8008/api/local"
